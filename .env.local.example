# MongoDB (REQUIRED — add your own)
MONGODB_URI=
MONGODB_DB_NAME=attendance

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Email — leave SMTP_USER/SMTP_PASS blank to use console-logging transport
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Geo Attendance <noreply@geo-attendance.local>"

# App defaults
DEFAULT_TIMEZONE=Asia/Kolkata
# Ping cadence in ms (default 5 min). Applies to EVERY path: browser tracker,
# native LocationTrackingService, and the plugin fallback (throttled to this
# rate). Read at runtime, so a change takes effect on the next poll. The native
# service clamps it to 15s–15min; the browser tracker to 5s–30min.
PING_INTERVAL_MS=300000
# Must exceed PING_INTERVAL_MS, or ordinary jitter leaves a sliver of every gap
# unaccounted. ~1.5x the interval.
PING_TRUST_WINDOW_MS=480000
MAX_PING_ACCURACY_METERS=100

# How far back a native geofence event's own timestamp may reach. The Android
# receiver queues failed uploads and retries them, so a genuine event can arrive
# hours late and is still applied at the time it HAPPENED. This bounds how far a
# stale or forged timestamp could rewrite history. Rejections return 400 so the
# device drops them instead of retrying forever.
GEOFENCE_MAX_EVENT_AGE_MINUTES=720
GEOFENCE_MAX_CLOCK_SKEW_MINUTES=5
MOCK_LOCATION_SPEED_KMH=200

# Test (used by Cypress)
CYPRESS_BASE_URL=http://localhost:3000

# Password the admin-seeding scripts use (scripts/reset-db.ts, replace-admin.ts).
# Never commit a real value — set it in .env.local.
SEED_ADMIN_PASSWORD=

# Auto check-in: check an employee in while they are inside their site during
# scheduled hours. Requires an EmployeeSchedule with expectedStartAt/EndAt —
# without a defined window it stays off. Set to false to disable entirely.
AUTO_CHECKIN_ENABLED=true
AUTO_CHECKIN_POLL_MS=60000

# A checked-in employee whose phone has not reported for this long shows as
# OFFLINE on the live board and triggers one admin alert. Must exceed
# PING_INTERVAL_MS comfortably so dropped pings do not raise false alarms.
OFFLINE_AFTER_MS=900000
# Raise an in-app admin notification (see /admin/notifications) when someone
# leaves the site or goes offline mid-shift. These are database rows, not email.
NOTIFY_ADMIN_ON_SITE_EXIT=true
NOTIFY_ADMIN_ON_OFFLINE=true

# Refuse check-in on a day the employee has no schedule for. An unscheduled day
# means "not working today"; treating a missing record as "no rule" let anyone
# clock in on any day. Set to false only for a company that does not use the
# schedule feature at all.
REQUIRE_SCHEDULE_FOR_CHECKIN=true
